<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="endRoot" prefHeight="600.0" prefWidth="600.0" styleClass="end-root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="EndController">

   <center>
      <VBox alignment="CENTER" spacing="15" styleClass="end-box">

         <children>

            <Label fx:id="lblOver" styleClass="end-title" text="GAME OVER" />

            <Label fx:id="lblResult" styleClass="end-subtitle" text="Result" />

            <HBox alignment="CENTER" spacing="10" styleClass="button-row">

               <children>
                  <Button fx:id="btnAgain" onAction="#playAgain" styleClass="submit-button" text="Play Again" />

                  <Button fx:id="btnQuit" onAction="#quit" styleClass="submit-button" text="Quit" />
               </children>

            </HBox>

         </children>
      </VBox>
   </center>

</BorderPane>
